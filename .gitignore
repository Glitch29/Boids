# IntelliJ compiler output
out/

# Generated artifacts: simulation frames and navigability maps.
# Everything here is reproducible from a seed plus the committed source.
render/

# Sweep output: one CSV per seed, ~1 MB each.
data/

# Summary tables that were derived from data/. Their producer no longer exists, so these
# are neither regenerable nor current; the directory is kept locally and not versioned.
analysis/

# Java
*.class

# Claude Code per-user settings (settings.json, if it ever exists, is shared)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Upload packet: assembled from source and case output, not versioned.
packet/

# Session transcripts: kept locally and mirrored to Drive, never committed.
transcripts/

# Map ingests. The frozen PNG and its metadata are committed, because they are what an
# old label replays against and cannot be recovered once the source PNG moves on.
# Everything else in an ingest folder is derived output and is not.
/ingests/**
!/ingests/**/
!/ingests/*/map.png
!/ingests/*/display.png
!/ingests/*/meta.txt

# The 'latest' pointer is a machine-local directory junction.
areas/*/latest
areas/*/latest.txt

# Working copies of maps mid-edit. A map only becomes real once it is ingested, and the
# ingest is what anything downstream reads, so intermediate drawings are not worth history.
areas/scratch/
